# Telegram bot token from @BotFather (REQUIRED)
TELEGRAM_BOT_TOKEN=

# Comma-separated list of Freepik API keys for automatic rotation (REQUIRED).
# Example: FREEPIK_API_KEYS=FPSXaaa...,FPSXbbb...
FREEPIK_API_KEYS=

# Optional: comma-separated Telegram user IDs of bot admins.
# If empty, the FIRST user who runs /start becomes admin (bootstrap mode).
ADMIN_USER_IDS=

# Optional: SQLite database path
DB_PATH=data/tryon_bot.sqlite3

# Optional: log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional: low-token threshold for warning notifications (default 10)
LOW_TOKEN_THRESHOLD=10

# Optional: output aspect ratio (3:4 default)
OUTPUT_ASPECT_RATIO=3:4

# Optional: output resolution: 1K, 2K (default), 4K
OUTPUT_RESOLUTION=2K

# Optional: footer brand text
BRAND_FOOTER=By : Aksara Strategy

# Optional: polling tunables (seconds)
POLL_INTERVAL=4
POLL_TIMEOUT=600
